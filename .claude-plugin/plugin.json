{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "epa-mcp-server",
  "version": "0.3.2",
  "description": "Search and retrieve EPA environmental data: facility compliance (ECHO), toxic releases (TRI), Superfund sites, drinking water systems, environmental-justice screening (EJScreen), and real-time air quality (AirNow). STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/epa-mcp-server#readme",
  "repository": "https://github.com/cyanheads/epa-mcp-server",
  "license": "Apache-2.0",
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "epa", "environmental"],
  "mcpServers": {
    "epa-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/epa-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
